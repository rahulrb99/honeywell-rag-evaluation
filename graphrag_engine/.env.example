# Copy this file to .env and fill in your values.

# OpenAI key used by the GraphRAG domain builder and query engine
OPENAI_API_KEY=sk-placeholder

# Neo4j connection (default values work for a local Docker instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Domain / model overrides (optional — build script has defaults)
GRAPH_DOMAIN_NAME=honeywell_fire_comms_subset_20260425
GRAPH_MODEL_NAME=gpt-4o-mini
