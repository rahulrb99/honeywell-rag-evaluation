# Copy this file to .env and fill in your real values.

# LLM credentials. OPENAI_API_KEY is optional; the project works with Groq only.
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=

# Generation / judge models.
GROQ_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile
GRAPH_MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0
JUDGE_TEMPERATURE=0

# Neo4j Aura or local Neo4j. NEO4J_USERNAME is accepted by the GraphRAG engine.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your_neo4j_password
GRAPH_DOMAIN_NAME=honeywell_fire_comms_subset_20260425

# Retrieval / vector baseline settings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
FETCH_K=20
LAMBDA_MULT=0.7
LOG_RETRIEVED_CONTEXTS=true
VECTORSTORE_DIR=data/vectorstore
PRODUCT_RECORDS_PATH=outputs/structured/product_records.json

# Optional live RAGAS throttling.
RAGAS_MAX_WORKERS=1
RAGAS_TIMEOUT_SEC=900
GROQ_MAX_RETRIES=8

# Legacy Week 1 defaults kept for archived scripts.
EVAL_CSV=data/eval/archive/week1_gold_triplets_20.csv
PREDICTIONS_CSV=outputs/debug/week1_rag_outputs.csv
JUDGE_SCORES_JSON=outputs/debug/week1_judge_scores.json
JUDGE_SCORES_CSV=outputs/debug/week1_judge_scores.csv
JUDGE_CONSISTENCY_JSON=outputs/debug/week1_judge_consistency.json
JUDGE_COMPARE_JSON=outputs/debug/week1_judge_vs_ragas.json
PARAPHRASE_VARIANTS=5
CONSISTENCY_QUESTIONS=5
GROUNDEDNESS_CSV=outputs/debug/week1_groundedness.csv
RETRIEVAL_RECALL_CSV=outputs/debug/week1_retrieval_metrics.csv
RETRIEVAL_ONLY_CSV=outputs/debug/week1_retrieval_metrics.csv
RETRIEVAL_ONLY_JSON=outputs/debug/week1_retrieval_only.json
GENERATION_ONLY_CSV=outputs/debug/week1_generation_only.csv
GENERATION_ONLY_JSON=outputs/debug/week1_generation_only.json
EVAL_ROWS_CSV=outputs/week1_eval_rows.csv
EVAL_SUMMARY_JSON=outputs/week1_eval_summary.json
FAILURE_DASHBOARD_HTML=outputs/dashboard/failure_dashboard.html
EXPERIMENTS_DIR=outputs/experiments
