<edge source="audio amplifiers" target="25v rms">
  <data key="d4">requires_voltage</data>
  <data key="d5">1</data>
  <data key="d6">daa2_amplifier_manual#chunk_0090</data>
  <data key="d7">daa2_amplifier_manual</data>
  <data key="d8">82</data>
  <data key="d9">0.94</data>
  <data key="d10">Figure C.1 DAL Block Diagram C.1.2 Features The DAA audio amplifiers have the following features: • 50W total output power at 25V RMS (all DAA-5025 model versions) or 70 VRMS (all DAA-5070 model versions).</data>
</edge>
<edge source="audio amplifiers" target="70 vrms">
  <data key="d4">requires_voltage</data>
  <data key="d5">1</data>
  <data key="d6">daa2_amplifier_manual#chunk_0090</data>
  <data key="d7">daa2_amplifier_manual</data>
  <data key="d8">82</data>
  <data key="d9">0.94</data>
  <data key="d10">Figure C.1 DAL Block Diagram C.1.2 Features The DAA audio amplifiers have the following features: • 50W total output power at 25V RMS (all DAA-5025 model versions) or 70 VRMS (all DAA-5070 model versions).</data>
</edge>
<edge source="dcadc daa2 class a daughter card" target="class a connections">
  <data key="d4">has_component|compatible_with</data>
  <data key="d5">2</data>
  <data key="d6">daa2_amplifier_manual#chunk_0090</data>
  <data key="d7">daa2_amplifier_manual</data>
  <data key="d8">82</data>
  <data key="d9">0.9</data>
  <data key="d10">• Two Class A connections for high- level audio output, or alternately, four Class B connections, or four Class A outputs when used with the DCADC DAA2 Class A Daughter Card, which dynamically share the 50W output capability.</data>
</edge>
